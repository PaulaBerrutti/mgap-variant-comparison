            echo "[DONE] CNV repeat analysis: {wildcards.species}"
        else
            status=$?
            echo "Exit status: $status" >> {log:q}
            echo "Failed: $(date -Is)" >> {log:q}
            echo "[ERROR] CNV repeat analysis: {wildcards.species}"
            exit "$status"
        fi
        """

# ==========================================
# Record sample processing status
# ==========================================

rule record_sample_status:
    input:
        manifest="cnv_validation/results/{species}/cnv_candidates.csv",
        coverage=lambda wc: [
            f"cnv_validation/results/{wc.species}/coverage/{sample}.csv"
            for sample in SPECIES[wc.species]["samples"]
        ],
        bam=lambda wc: [
            f"data/{wc.species}/{sample}/{sample}.sorted.bam"
            for sample in SPECIES[wc.species]["samples"]
        ],
        bai=lambda wc: [
            f"data/{wc.species}/{sample}/{sample}.sorted.bam.bai"
            for sample in SPECIES[wc.species]["samples"]
        ]

    output:
        "cnv_validation/results/{species}/sample_input_status.csv"

    log:
        "cnv_validation/logs/{species}/sample_input_status.log"

    run:
        from datetime import datetime
        import sys

        print(f"[START] Sample status: {wildcards.species}")

        samples = SPECIES[wildcards.species]["samples"]

        output_path = Path(output[0])
        log_path = Path(log[0])

        output_path.parent.mkdir(parents=True, exist_ok=True)
        log_path.parent.mkdir(parents=True, exist_ok=True)

        with log_path.open("a") as logfile:
            logfile.write(
                f"\nStarted: {datetime.now().astimezone().isoformat()}\n"
            )
            logfile.write(f"Species: {wildcards.species}\n")
            logfile.write(f"Python: {sys.version}\n")

            rows = []

            for sample in samples:
                bam = Path(
                    f"data/{wildcards.species}/{sample}/{sample}.sorted.bam"
                )
                bai = Path(str(bam) + ".bai")
                coverage = Path(
                    f"cnv_validation/results/{wildcards.species}/"
                    f"coverage/{sample}.csv"
                )

                if not all(
                    path.is_file() and path.stat().st_size > 0
                    for path in (bam, bai, coverage)
                ):
                    logfile.write(f"ERROR: Missing input for {sample}\n")
                    raise ValueError(f"Missing required input: {sample}")

                rows.append({
                    "Sample": sample,
                    "Input_status": "READY",
                    "Input_details": (
                        "Sorted BAM, index and coverage available"
                    )
                })

                logfile.write(f"READY: {sample}\n")

            with output_path.open("w", newline="") as f:
                writer = csv.DictWriter(
                    f,
                    fieldnames=[
                        "Sample",
                        "Input_status",
                        "Input_details"
                    ]
                )
                writer.writeheader()
                writer.writerows(rows)

            logfile.write(f"Total READY: {len(rows)}\n")
            logfile.write(
                f"Finished: {datetime.now().astimezone().isoformat()}\n"
            )
            logfile.write("Exit status: 0\n")

        print(f"[DONE] Sample status: {wildcards.species}")

# ==========================================
# Build the final CNV validation report
# ==========================================

rule build_cnv_report:
    input:
        manifest="cnv_validation/results/{species}/cnv_candidates.csv",
        coverage=lambda wc: [
            f"cnv_validation/results/{wc.species}/coverage/{sample}.csv"
            for sample in SPECIES[wc.species]["samples"]
        ],
        repeats="cnv_validation/results/{species}/cnv_repeat_evidence.csv",
        status="cnv_validation/results/{species}/sample_input_status.csv",
        script="cnv_validation/scripts/build_cnv_report_multi.py"

    output:
        "cnv_validation/results/{species}/cnv_validation_report_multi.md"

    params:
        coverage_dir=lambda wc: (
            f"cnv_validation/results/{wc.species}/coverage"
        )

    log:
        "cnv_validation/logs/{species}/cnv_report.log"

    shell:
        """
        set -euo pipefail

        mkdir -p cnv_validation/logs/{wildcards.species}

        echo "[START] CNV report: {wildcards.species}"

        echo "========================================" >> {log:q}
        echo "Started: $(date -Is)" >> {log:q}
        echo "Species: {wildcards.species}" >> {log:q}
        echo "Manifest: {input.manifest}" >> {log:q}
        echo "Coverage directory: {params.coverage_dir}" >> {log:q}
        echo "Repeat evidence: {input.repeats}" >> {log:q}
        echo "Sample status: {input.status}" >> {log:q}
        echo "Output: {output}" >> {log:q}

        python --version >> {log:q} 2>&1

        echo "Command: python {input.script} {input.manifest} {params.coverage_dir} {input.repeats} {input.status} {output}" >> {log:q}

        if python {input.script:q} \
            {input.manifest:q} \
            {params.coverage_dir:q} \
            {input.repeats:q} \
            {input.status:q} \
            {output:q} >> {log:q} 2>&1
        then
            echo "Exit status: 0" >> {log:q}
            echo "Finished: $(date -Is)" >> {log:q}
            echo "[DONE] CNV report: {wildcards.species}"
        else
            status=$?
            echo "Exit status: $status" >> {log:q}
            echo "Failed: $(date -Is)" >> {log:q}
            echo "[ERROR] CNV report: {wildcards.species}"
            echo "See diagnostic log: {log}"
            exit "$status"
        fi
        """
