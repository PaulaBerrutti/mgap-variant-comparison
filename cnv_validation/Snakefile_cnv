# ==========================================
# Universal CNV Validation Pipeline
# ==========================================

from pathlib import Path
import csv

# ------------------------------------------
# Discover reference genomes and accessions
# ------------------------------------------

REFERENCES = {}

for fasta in sorted(Path("references").glob("*.fasta")):

    accessions = set()

    with fasta.open() as f:
        for line in f:
            if line.startswith(">"):
                accessions.add(line[1:].split()[0])

    REFERENCES[str(fasta)] = accessions


# ------------------------------------------
# Discover species and samples
# ------------------------------------------

SPECIES = {}

for csv_path in sorted(
    Path("results").glob("*/cnv_comparison_all.csv")
):

    species = csv_path.parent.name

    with csv_path.open(newline="") as f:
        rows = list(csv.DictReader(f))

    chromosomes = {
        row["Chromosome"].strip()
        for row in rows
    }

    matches = [
        fasta
        for fasta, accessions in REFERENCES.items()
        if chromosomes and chromosomes.issubset(accessions)
    ]

    if len(matches) != 1:
        raise ValueError(
            f"{species}: expected one matching reference, "
            f"found {len(matches)}"
        )

    sample_dir = Path("data") / species

    if not sample_dir.is_dir():
        raise ValueError(
            f"{species}: sample directory missing"
        )

    samples = sorted(
        folder.name
        for folder in sample_dir.iterdir()
        if folder.is_dir()
    )

    if not samples:
        raise ValueError(
            f"{species}: no samples found"
        )

    SPECIES[species] = {
        "reference": matches[0],
        "samples": samples
    }

    print(
        f"DISCOVERED: {species} | "
        f"{len(samples)} samples | "
        f"{matches[0]}"
    )


# ------------------------------------------
# Workflow targets — first testing stage
# ------------------------------------------

rule all:
    input:
        # CNV candidate manifests
        expand(
            "cnv_validation/results/{species}/cnv_candidates.csv",
            species=sorted(SPECIES)
        ),

        # Reference indexes
        [
            f"{info['reference']}.{suffix}"
            for info in SPECIES.values()
            for suffix in ("amb", "ann", "bwt", "pac", "sa", "fai")
        ],

        # Sorted BAM indexes for all samples
        [
            f"data/{species}/{sample}/{sample}.sorted.bam.bai"
            for species, info in SPECIES.items()
            for sample in info["samples"]
        ],

        # CNV coverage for all samples
        [
            f"cnv_validation/results/{species}/coverage/{sample}.csv"
            for species, info in SPECIES.items()
            for sample in info["samples"]
        ],

        # Reference-repeat evidence for every species
        [
            f"cnv_validation/results/{species}/cnv_repeat_evidence.csv"
            for species in sorted(SPECIES)
        ],

        # Sample processing status for all species
        [
            f"cnv_validation/results/{species}/sample_input_status.csv"
            for species in sorted(SPECIES)
        ],

        # Final CNV validation reports
        [
            f"cnv_validation/results/{species}/cnv_validation_report_multi.md"
            for species in sorted(SPECIES)
        ]

# ------------------------------------------
# Prepare CNV candidate manifest
# ------------------------------------------

rule prepare_cnv_candidates:
    input:
        csv="results/{species}/cnv_comparison_all.csv",
        script="cnv_validation/scripts/prepare_cnv_candidates_multi.py"
    output:
        "cnv_validation/results/{species}/cnv_candidates.csv"
    params:
        samples=lambda wc: " ".join(
            SPECIES[wc.species]["samples"]
        )
    shell:
        """
        python {input.script:q} \
            {input.csv:q} \
            {output:q} \
            {params.samples}
        """

# ==========================================
# Index reference genomes for BWA-MEM
# ==========================================

rule bwa_index:
    input:
        "references/{refname}.fasta"
    output:
        "references/{refname}.fasta.amb",
        "references/{refname}.fasta.ann",
        "references/{refname}.fasta.bwt",
        "references/{refname}.fasta.pac",
        "references/{refname}.fasta.sa"
    shell:
        "bwa index {input:q}"


# ==========================================
# Index reference genomes for samtools
# ==========================================

rule samtools_faidx:
    input:
        "references/{refname}.fasta"
    output:
        "references/{refname}.fasta.fai"
    shell:
        "samtools faidx {input:q}"

# ==========================================
# Map paired FASTQs and create sorted BAM
# ==========================================

rule map_reads:
    input:
        reference=lambda wc: SPECIES[wc.species]["reference"],
        bwa_index=lambda wc: [
            SPECIES[wc.species]["reference"] + "." + ext
            for ext in ("amb", "ann", "bwt", "pac", "sa")
        ],
        r1="data/{species}/{sample}/{sample}_R1.fq.gz",
        r2="data/{species}/{sample}/{sample}_R2.fq.gz"

    output:
        bam="data/{species}/{sample}/{sample}.sorted.bam"

    log:
        bwa="cnv_validation/logs/{species}/{sample}/bwa_mapping.log",
        sort="cnv_validation/logs/{species}/{sample}/samtools_sort.log",
        qc="cnv_validation/logs/{species}/{sample}/samtools_quickcheck.log"

    threads: 4

    shell:
        """
        set -euo pipefail

        mkdir -p cnv_validation/logs/{wildcards.species}/{wildcards.sample}

        echo "[START] Mapping and sorting: {wildcards.sample}"

        echo "===== $(date -Is) | bwa mem =====" >> {log.bwa:q}
        echo "Reference: {input.reference}" >> {log.bwa:q}
        echo "R1: {input.r1}" >> {log.bwa:q}
        echo "R2: {input.r2}" >> {log.bwa:q}

        echo "===== $(date -Is) | samtools sort =====" >> {log.sort:q}

        if bwa mem -t 3 \
            {input.reference:q} \
            {input.r1:q} \
            {input.r2:q} \
            2>> {log.bwa:q} |
            samtools sort -@ 1 -m 1G \
            -o {output.bam:q} - \
            2>> {log.sort:q}
        then
            echo "[DONE] Mapping and sorting: {wildcards.sample}"
        else
            echo "[ERROR] Mapping or sorting failed: {wildcards.sample}"
            exit 1
        fi

        echo "[START] Checking BAM: {wildcards.sample}"

        echo "===== $(date -Is) | samtools quickcheck =====" >> {log.qc:q}

        if samtools quickcheck -v {output.bam:q} >> {log.qc:q} 2>&1
        then
            echo "PASS: BAM quickcheck" >> {log.qc:q}
            echo "[DONE] BAM check: {wildcards.sample}"
        else
            echo "[ERROR] BAM check failed: {wildcards.sample}"
            exit 1
        fi
        """

# ==========================================
# Index sorted BAM with detailed logging
# ==========================================

rule bam_index:
    input:
        bam="data/{species}/{sample}/{sample}.sorted.bam"

    output:
        bai="data/{species}/{sample}/{sample}.sorted.bam.bai"

    log:
        "cnv_validation/logs/{species}/{sample}/samtools_index.log"

    shell:
        """
        set -euo pipefail

        mkdir -p cnv_validation/logs/{wildcards.species}/{wildcards.sample}

        echo "[START] BAM indexing: {wildcards.sample}"

        echo "========================================" >> {log:q}
        echo "Started: $(date -Is)" >> {log:q}
        echo "Sample: {wildcards.sample}" >> {log:q}
        echo "Input: {input.bam}" >> {log:q}
        echo "Output: {output.bai}" >> {log:q}
        samtools --version | sed -n '1p' >> {log:q}
        echo "Command: samtools index {input.bam} {output.bai}" >> {log:q}

        if samtools index \
            {input.bam:q} \
            {output.bai:q} >> {log:q} 2>&1
        then
            echo "Exit status: 0" >> {log:q}
            echo "Finished: $(date -Is)" >> {log:q}
            echo "[DONE] BAM indexing: {wildcards.sample}"
        else
            status=$?
            echo "Exit status: $status" >> {log:q}
            echo "Failed: $(date -Is)" >> {log:q}
            echo "[ERROR] BAM indexing: {wildcards.sample}"
            exit "$status"
        fi
        """

