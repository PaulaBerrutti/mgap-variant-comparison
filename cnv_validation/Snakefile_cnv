# ==========================================
# Analyze CNV reference repeats
# ==========================================

rule analyze_cnv_repeats:
    input:
        reference=lambda wc: SPECIES[wc.species]["reference"],
        fai=lambda wc: SPECIES[wc.species]["reference"] + ".fai",
        bwa_index=lambda wc: [
            SPECIES[wc.species]["reference"] + "." + ext
            for ext in ("amb", "ann", "bwt", "pac", "sa")
        ],
        manifest="cnv_validation/results/{species}/cnv_candidates.csv",
        script="cnv_validation/scripts/analyze_cnv_repeats.py"

    output:
        "cnv_validation/results/{species}/cnv_repeat_evidence.csv"

    log:
        "cnv_validation/logs/{species}/cnv_repeat_analysis.log"

    threads: 1

    shell:
        """
        set -euo pipefail

        mkdir -p cnv_validation/logs/{wildcards.species}

        echo "[START] CNV repeat analysis: {wildcards.species}"

        echo "========================================" >> {log:q}
        echo "Started: $(date -Is)" >> {log:q}
        echo "Species: {wildcards.species}" >> {log:q}
        echo "Reference: {input.reference}" >> {log:q}
        echo "Manifest: {input.manifest}" >> {log:q}
        echo "Output: {output}" >> {log:q}

        python --version >> {log:q} 2>&1
        samtools --version | sed -n '1p' >> {log:q}
        bwa 2>&1 | grep -m 1 'Version:' >> {log:q} || true

        echo "Running: python {input.script} {input.reference} {input.manifest} {output}" >> {log:q}

        if python {input.script:q} \
            {input.reference:q} \
            {input.manifest:q} \
            {output:q} >> {log:q} 2>&1
        then
            echo "Exit status: 0" >> {log:q}
